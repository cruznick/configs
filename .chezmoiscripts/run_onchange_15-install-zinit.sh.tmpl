#!/usr/bin/env bash
# Bootstrap zinit when enabled; toggling the integration reruns this hook.
set -euo pipefail
{{ $cfg := includeTemplate ".chezmoitemplates/homebrew-config.json.tmpl" . | fromJson }}
{{ if not $cfg.optional_integrations.zinit -}}
echo "Skipping zinit: disabled by optional_integrations.zinit"
exit 0
{{ end -}}

ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
warn() { printf "\033[1;33m[WARN] %s\033[0m\n" "$*" >&2; }

if [[ ! -d "$ZINIT_HOME" ]]; then
  echo "Installing zinit..."
  mkdir -p "$(dirname "$ZINIT_HOME")"
  if git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"; then
    echo "  Cloned to $ZINIT_HOME"
  else
    warn "Unable to clone zinit; skipping for now"
    exit 0
  fi
else
  echo "  zinit already installed at $ZINIT_HOME"
fi

echo ""
echo "✅ run_onchange_15: zinit plugin manager ready"
