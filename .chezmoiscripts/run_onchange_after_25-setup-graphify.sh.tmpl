#!/usr/bin/env bash
# Install Graphify's CLI and register its Codex skill for the current user.
set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "Skipping Graphify setup: not macOS"
exit 0
{{ end -}}

warn() { printf "\033[1;33m[WARN] %s\033[0m\n" "$*" >&2; }

if ! command -v uv >/dev/null 2>&1; then
  warn "uv not found; skipping Graphify setup"
  exit 0
fi

if ! uv tool install --upgrade graphifyy; then
  warn "Graphify CLI installation failed; retry after resolving the error"
  exit 0
fi

if ! uv tool run --from graphifyy graphify install --platform codex; then
  warn "Graphify Codex skill registration failed; retry with: uv tool run --from graphifyy graphify install --platform codex"
  exit 0
fi

echo "✅ Graphify CLI installed and Codex skill registered"
