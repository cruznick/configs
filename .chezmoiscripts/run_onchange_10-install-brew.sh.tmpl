#!/usr/bin/env bash
# run_onchange_10-install-brew.sh — Install Homebrew packages from grouped Brewfiles
# Re-runs automatically whenever this file or any tracked Brewfile group changes.
set -euo pipefail
{{ $cfg := includeTemplate ".chezmoitemplates/homebrew-config.json.tmpl" . | fromJson }}
{{ $optional := $cfg.optional_integrations | default dict }}
{{ $personalEnabled := eq $cfg.active_profile "personal" }}
{{ if hasKey $optional "homebrew_personal" }}
  {{ $personalEnabled = $optional.homebrew_personal }}
{{ end }}
{{ $homebrewEnabled := or $optional.homebrew_core $optional.homebrew_dev $optional.homebrew_apps $personalEnabled $optional.homebrew_extras $optional.homebrew_work }}
{{ $brewfile := includeTemplate ".chezmoitemplates/homebrew-active-brewfile.tmpl" . }}

{{ if ne .chezmoi.os "darwin" -}}
echo "Skipping brew install: not macOS"
exit 0
{{ end -}}

log() { printf "\n\033[1;34m==> %s\033[0m\n" "$*"; }
warn() { printf "\033[1;33m[WARN] %s\033[0m\n" "$*" >&2; }

{{ if not $homebrewEnabled }}
echo "Skipping brew install: all Homebrew groups are disabled"
exit 0
{{ end }}

if ! command -v brew >/dev/null 2>&1; then
  warn "Homebrew not found; skipping package installation"
  exit 0
fi

BREWFILE="$(mktemp "${TMPDIR:-/tmp}/dotfiles-brew.XXXXXX")"
cleanup() {
  rm -f "$BREWFILE"
}
trap cleanup EXIT

cat >"$BREWFILE" <<'EOF'
{{ $brewfile }}
EOF

log "Installing missing packages from declared Brewfile groups"
if brew bundle install --no-upgrade --file="$BREWFILE"; then
  echo "Declared Homebrew packages are installed"
else
  warn "brew bundle install reported failures; run dots-brew sync to retry"
fi

# ── fzf shell integration (no rc changes — chezmoi manages zshrc) ─────────────
if [[ -x "$(brew --prefix)/opt/fzf/install" ]]; then
  "$(brew --prefix)/opt/fzf/install" --key-bindings --completion --no-update-rc >/dev/null 2>&1 || true
fi

echo ""
echo "run_onchange_10: Homebrew install pass complete (see any warnings above)"
echo ""
echo "⚡ Notes:"
echo "  - source of truth: homebrew/Brewfile.*"
echo "  - cleanup is manual only: dots-brew cleanup"
echo "  - upgrades are explicit: dots-brew update"
echo "  - terraform, kubectl, and helm are managed by asdf (run_onchange_20 handles install)"
