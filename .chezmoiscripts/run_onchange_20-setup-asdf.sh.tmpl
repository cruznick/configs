#!/usr/bin/env bash
# Synchronize asdf tools after files are applied, including version-file changes.
# tool-versions-sha256: {{ include "dot_tool-versions" | sha256sum }}
set -euo pipefail
{{ $cfg := includeTemplate ".chezmoitemplates/effective-config.json.tmpl" . | fromJson }}
{{ $optional := $cfg.optional_integrations | default dict }}
{{ if and (hasKey $optional "asdf") (not (index $optional "asdf")) -}}
echo "Skipping asdf: disabled by optional_integrations.asdf"
exit 0
{{ end -}}

{{ if ne .chezmoi.os "darwin" -}}
echo "Skipping: not macOS"
exit 0
{{ end -}}

warn() { printf "\033[1;33m[WARN] %s\033[0m\n" "$*" >&2; }

if ! command -v asdf >/dev/null 2>&1; then
  warn "asdf not found; skipping version install"
  exit 0
fi

export ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
export PATH="$ASDF_DATA_DIR/shims:$PATH"
# Do not pick up a project's .tool-versions from the caller's directory.
cd {{ .chezmoi.homeDir | quote }}

add_plugin() {
  local name="$1" url="$2"
  local installed_plugins
  installed_plugins="$(asdf plugin list)" || return 1
  grep -qx "$name" <<<"$installed_plugins" || asdf plugin add "$name" "$url"
}

if ! {
  add_plugin nodejs    https://github.com/asdf-vm/asdf-nodejs.git &&
  add_plugin python    https://github.com/asdf-community/asdf-python.git &&
  add_plugin golang    https://github.com/asdf-community/asdf-golang.git &&
  add_plugin terraform https://github.com/asdf-community/asdf-hashicorp.git &&
  add_plugin kubectl   https://github.com/asdf-community/asdf-kubectl.git &&
  add_plugin helm      https://github.com/Antiarchitect/asdf-helm.git
}; then
  warn "asdf plugin setup failed; retry after resolving the error"
  exit 0
fi

# Install versions from ~/.tool-versions (chezmoi will deploy that file)
if ! asdf install; then
  warn "asdf install failed; retry from your home directory after resolving the error"
  exit 0
fi

# Node: enable corepack
command -v corepack >/dev/null && corepack enable || true
if ! asdf reshim; then
  warn "asdf reshim failed; retry after resolving the error"
  exit 0
fi

echo "✅ asdf tool versions installed"
