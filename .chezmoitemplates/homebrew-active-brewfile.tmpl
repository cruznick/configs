{{- $cfg := includeTemplate ".chezmoitemplates/homebrew-config.json.tmpl" . | fromJson -}}
{{- $optional := (index $cfg "optional_integrations") | default dict -}}
{{- $externalCasks := (index $cfg "externally_managed_casks") | default (list) -}}
{{- $coreEnabled := true -}}
{{- if hasKey $optional "homebrew_core" -}}
  {{- $coreEnabled = (index $optional "homebrew_core") -}}
{{- end -}}
{{- $devEnabled := true -}}
{{- if hasKey $optional "homebrew_dev" -}}
  {{- $devEnabled = (index $optional "homebrew_dev") -}}
{{- end -}}
{{- $appsEnabled := true -}}
{{- if hasKey $optional "homebrew_apps" -}}
  {{- $appsEnabled = (index $optional "homebrew_apps") -}}
{{- end -}}
{{- $activeProfile := (index $cfg "active_profile") | default "personal" -}}
{{- $personalEnabled := eq $activeProfile "personal" -}}
{{- if hasKey $optional "homebrew_personal" -}}
  {{- $personalEnabled = (index $optional "homebrew_personal") -}}
{{- end -}}
{{- $extrasEnabled := false -}}
{{- if hasKey $optional "homebrew_extras" -}}
  {{- $extrasEnabled = (index $optional "homebrew_extras") -}}
{{- end -}}
{{- $workEnabled := false -}}
{{- if hasKey $optional "homebrew_work" -}}
  {{- $workEnabled = (index $optional "homebrew_work") -}}
{{- end -}}
# Generated from repo-tracked Homebrew group files.
# Source of truth lives under homebrew/.
{{- if $coreEnabled }}

# group: core
{{ includeTemplate ".chezmoitemplates/homebrew-filter-casks.tmpl" (dict "content" (include "homebrew/Brewfile.core") "external" $externalCasks) }}
{{ end -}}
{{- if $devEnabled }}

# group: dev
{{ includeTemplate ".chezmoitemplates/homebrew-filter-casks.tmpl" (dict "content" (include "homebrew/Brewfile.dev") "external" $externalCasks) }}
{{ end -}}
{{- if $appsEnabled }}

# group: apps
{{ includeTemplate ".chezmoitemplates/homebrew-filter-casks.tmpl" (dict "content" (include "homebrew/Brewfile.apps") "external" $externalCasks) }}
{{ end -}}
{{- if $personalEnabled }}

# group: personal
{{ includeTemplate ".chezmoitemplates/homebrew-filter-casks.tmpl" (dict "content" (include "homebrew/Brewfile.personal") "external" $externalCasks) }}
{{ end -}}
{{- if $extrasEnabled }}

# group: extras
{{ includeTemplate ".chezmoitemplates/homebrew-filter-casks.tmpl" (dict "content" (include "homebrew/Brewfile.extras") "external" $externalCasks) }}
{{ end -}}
{{- if $workEnabled }}

# group: work
{{ includeTemplate ".chezmoitemplates/homebrew-filter-casks.tmpl" (dict "content" (include "homebrew/Brewfile.work") "external" $externalCasks) }}
{{ end -}}
