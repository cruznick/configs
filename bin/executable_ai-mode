#!/usr/bin/env zsh
# Source this file from .zshrc: it defines a per-terminal mode switch and
# wrappers that pass Bedrock settings only to Claude/Codex launched here.

if [[ "${ZSH_EVAL_CONTEXT:-}" != *:file ]]; then
  print -u2 "ai-mode must be sourced by zsh; add 'source ~/bin/ai-mode' to ~/.zshrc"
  exit 2
fi

ai-mode() {
  local mode="${1:-status}" tool="${2:-all}"

  case "$tool" in
    all|claude|codex) ;;
    *) print -u2 "Usage: ai-mode <bedrock|login|status> [claude|codex]"; return 2 ;;
  esac

  case "$mode" in
    bedrock|login)
      if [[ "$tool" == all || "$tool" == claude ]]; then
        if [[ "$mode" == bedrock ]]; then
          export AI_MODE_CLAUDE=bedrock
        else
          unset AI_MODE_CLAUDE
        fi
      fi
      if [[ "$tool" == all || "$tool" == codex ]]; then
        if [[ "$mode" == bedrock ]]; then
          export AI_MODE_CODEX=bedrock
        else
          unset AI_MODE_CODEX
        fi
      fi
      print "AI modes for this terminal:"
      [[ "$tool" == all || "$tool" == claude ]] && print "  Claude: ${AI_MODE_CLAUDE:-login}"
      [[ "$tool" == all || "$tool" == codex ]] && print "  Codex:  ${AI_MODE_CODEX:-login}"
      if [[ "$mode" == bedrock ]]; then
        print "Run: aws sso login --profile platform"
      fi
      ;;
    status)
      [[ "$tool" == all || "$tool" == claude ]] && print "Claude: ${AI_MODE_CLAUDE:-login}"
      [[ "$tool" == all || "$tool" == codex ]] && print "Codex:  ${AI_MODE_CODEX:-login}"
      ;;
    -h|--help|help)
      print "Usage: ai-mode <bedrock|login|status> [claude|codex]"
      print "Changes affect only this terminal; new terminals start in login mode."
      ;;
    *)
      print -u2 "Usage: ai-mode <bedrock|login|status> [claude|codex]"
      return 2
      ;;
  esac
}

claude() {
  local binary="$(whence -p claude)"
  if [[ -z "$binary" ]]; then
    print -u2 "claude executable not found on PATH"
    return 127
  fi
  if [[ "${AI_MODE_CLAUDE:-login}" == bedrock ]]; then
    env \
      CLAUDE_CODE_USE_BEDROCK=1 \
      AWS_PROFILE=platform \
      AWS_REGION=us-west-2 \
      AWS_DEFAULT_REGION=us-west-2 \
      ANTHROPIC_MODEL=sonnet \
      ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-opus-5-5 \
      "$binary" "$@"
  else
    "$binary" "$@"
  fi
}

codex() {
  local binary="$(whence -p codex)"
  if [[ -z "$binary" ]]; then
    print -u2 "codex executable not found on PATH"
    return 127
  fi
  if [[ "${AI_MODE_CODEX:-login}" == bedrock ]]; then
    local -a overrides
    overrides=(
      -c 'model_provider="amazon-bedrock-runtime"'
      -c 'model="global.openai.gpt-6-astra"'
      -c 'model_reasoning_effort="low"'
      -c 'web_search="disabled"'
      -c 'model_providers.amazon-bedrock-runtime.aws.profile="platform"'
      -c 'model_providers.amazon-bedrock-runtime.aws.region="us-west-2"'
    )
    "$binary" "${overrides[@]}" "$@"
  else
    "$binary" "$@"
  fi
}
