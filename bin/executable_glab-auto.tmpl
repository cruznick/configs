{{- $cfg := includeTemplate ".chezmoitemplates/effective-config.json.tmpl" . | fromJson -}}
#!/usr/bin/env bash
# Directory-scoped glab account routing. Tokens in the environment take precedence.
set -euo pipefail
{{ includeTemplate ".chezmoitemplates/cli-context.sh.tmpl" . }}
case "$context" in
{{ range $slug := $cfg.selected_work_contexts -}}
{{ $ctx := index $cfg.work_contexts $slug -}}
  {{ $slug | quote }})
{{ if has "gl" (index ((index $ctx "providers") | default dict) "enabled" | default list) -}}
    export GLAB_CONFIG_DIR="{{ joinPath $.chezmoi.homeDir ".config" ((index ((index $ctx "cli") | default dict) "glab_config_dir") | default (printf "glab-%s" $slug)) }}"
{{ else -}}
    echo "glab is disabled in context {{ $slug }}" >&2
    exit 1
{{ end -}}
    ;;
{{ end -}}
  *) export GLAB_CONFIG_DIR="{{ .chezmoi.homeDir }}/.config/glab-personal" ;;
esac
exec glab "$@"
